#!/usr/bin/expect -f
# Copyright (c) 2026 SECOM CO., LTD. All rights reserved.
# SPDX-License-Identifier: BSD-2-Clause
set timeout 900
log_user 1

if {$argc != 3} {
    puts stderr "usage: $argv0 LOG_FILE MODE ATTESTAM_URL"
    exit 2
}
set log_path [lindex $argv 0]
set mode [lindex $argv 1]
set attestam_url [lindex $argv 2]
if {![regexp {^(attestam-live|attestam-verified-catalog|attestam-verified-app)$} $mode]} {
    puts stderr "unsupported RISC-V live phase mode: $mode"
    exit 2
}
if {![regexp {^http://[A-Za-z0-9.:[\]_-]+(/[A-Za-z0-9._~:/?#\[\]@!$&'()*+,;=%-]*)?$} $attestam_url]} {
    puts stderr "invalid AttesTAM URL"
    exit 2
}

log_file -a $log_path
spawn telnet 127.0.0.1 64320

proc shutdown_and_exit {code message} {
    puts stderr $message
    send -- "\003"
    after 250
    send -- "sync; poweroff\r"
    expect {
        eof {}
        timeout { puts stderr "ERROR: timed out waiting for QEMU poweroff after failure" }
    }
    exit $code
}

expect {
    -re {buildroot login:} { send "root\r" }
    timeout { puts stderr "ERROR: timed out waiting for Buildroot login"; exit 2 }
    eof { puts stderr "ERROR: console closed before login"; exit 2 }
}
expect -re {# $}
send "export PS1='TWEPV9# '\r"
expect -exact "TWEPV9# "

send -- "TWEP_TEE_FS_PARENT=/data/tee TWEP_TRUSTZONE_RESET_STORAGE=1 ATTESTAM_URL='$attestam_url' /opt/twep/run_trustzone_smokes.sh $mode; rc=\$?; echo __TWEP_PHASE_RC__\$rc\r"
expect {
    -re {__TWEP_PHASE_RC__0} {}
    -re {__TWEP_PHASE_RC__[1-9][0-9]*} {
        shutdown_and_exit 10 "ERROR: RISC-V live phase failed: $mode"
    }
    timeout { shutdown_and_exit 11 "ERROR: timeout in RISC-V live phase: $mode" }
}
expect -exact "TWEPV9# "

send -- "dmesg | tail -n 120; ! dmesg | grep -Ei 'panic|Oops|soft lockup|rcu.*stall'; rc=\$?; echo __KERNEL_HEALTH_RC__\$rc\r"
expect {
    -re {__KERNEL_HEALTH_RC__0} {}
    -re {__KERNEL_HEALTH_RC__[1-9][0-9]*} {
        shutdown_and_exit 12 "ERROR: kernel health check failed"
    }
    timeout { shutdown_and_exit 13 "ERROR: timeout in kernel health check" }
}
expect -exact "TWEPV9# "
send -- "sync; poweroff\r"
expect {
    eof {}
    timeout { puts stderr "ERROR: timed out waiting for QEMU poweroff"; exit 14 }
}
wait
