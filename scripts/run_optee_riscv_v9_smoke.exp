#!/usr/bin/expect -f
# Copyright (c) 2026 SECOM CO., LTD. All rights reserved.
# SPDX-License-Identifier: BSD-2-Clause
set timeout 300
log_user 1

if {$argc != 1} {
    puts stderr "usage: $argv0 LOG_FILE"
    exit 2
}
log_file -a [lindex $argv 0]
spawn telnet 127.0.0.1 64320
expect {
    -re {buildroot login:} { send "root\r" }
    timeout { puts stderr "ERROR: timed out waiting for Buildroot login"; exit 2 }
    eof { puts stderr "ERROR: console closed before login"; exit 2 }
}
expect -re {# $}
send "export PS1='TWEPV9# '\r"
expect -exact "TWEPV9# "

proc run_ok {name cmd} {
    send -- "$cmd; rc=\$?; echo __${name}_RC__\$rc\r"
    expect {
        -re "__${name}_RC__0" {}
        -re "__${name}_RC__\[1-9\]\[0-9\]*" {
            puts stderr "ERROR: $name failed"
            exit 10
        }
        timeout { puts stderr "ERROR: timeout in $name"; exit 11 }
    }
    expect -exact "TWEPV9# "
}

set smoke_env {TWEP_TEE_FS_PARENT=/data/tee TWEP_TRUSTZONE_RESET_STORAGE=1}
run_ok metadata {uname -a; cat /proc/version; ls -l /dev/tee*; test -x /usr/bin/twepd; test -s /usr/lib/libtwep_wr.so; test -s /lib/optee_armtz/6b9f4d2a-2f3e-4c7b-9d21-5a6f0e3c8b10.ta; sha256sum /usr/bin/twepd /usr/lib/libtwep_wr.so /lib/optee_armtz/6b9f4d2a-2f3e-4c7b-9d21-5a6f0e3c8b10.ta}
run_ok default "$smoke_env /opt/twep/run_trustzone_smokes.sh default"
run_ok wamr_linked "$smoke_env /opt/twep/run_trustzone_smokes.sh wamr-spike-linked"
run_ok wamr_negatives "$smoke_env /opt/twep/run_trustzone_smokes.sh wamr-spike-negatives"
run_ok execute_helloworld "$smoke_env /opt/twep/run_trustzone_smokes.sh execute-helloworld"
run_ok execute_timeout "$smoke_env /opt/twep/run_trustzone_smokes.sh execute-timeout-negative"
run_ok teep_resolve "$smoke_env /opt/twep/run_trustzone_smokes.sh teep-agent-resolve"
run_ok public_abi_helloworld "$smoke_env /opt/twep/run_trustzone_smokes.sh public-abi-execute-helloworld"
run_ok public_abi_calcadd "$smoke_env /opt/twep/run_trustzone_smokes.sh public-abi-execute-calcadd"
run_ok daemon_helloworld {state=/tmp/twepd-v9; mkdir -p "$state/run"; cd /opt/twep/guest; twepd --socket "$state/run/twepd.sock" --state-dir "$state" --once >"$state/twepd.log" 2>&1 & pid=$!; i=0; while test $i -lt 100 && test ! -S "$state/run/twepd.sock"; do sleep 0.1; i=$((i+1)); done; twep-cli --socket "$state/run/twepd.sock" helloworld >"$state/cli.out"; cli_rc=$?; wait $pid; daemon_rc=$?; cat "$state/cli.out"; cat "$state/twepd.log"; test $cli_rc -eq 0; test $daemon_rc -eq 0; grep -Fx 'Hello, World!!' "$state/cli.out"}
run_ok kernel_health {dmesg | tail -n 120; ! dmesg | grep -Ei 'panic|Oops|soft lockup|rcu.*stall'}
send -- "sync; poweroff\r"
expect {
    eof {}
    timeout { puts stderr "ERROR: timed out waiting for QEMU poweroff"; exit 12 }
}
wait
